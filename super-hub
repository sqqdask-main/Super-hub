    if UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.RightShift then frame.Visible = not frame.Visible
    elseif input.KeyCode == Enum.KeyCode.K then CFG.killaura = not CFG.killaura; refresh()
    elseif input.KeyCode == Enum.KeyCode.T then CFG.autoTotem = not CFG.autoTotem; refresh()
    elseif input.KeyCode == Enum.KeyCode.P then CFG.esp = not CFG.esp; refresh()
    elseif input.KeyCode == Enum.KeyCode.C then CFG.critOnly = not CFG.critOnly; refresh()
    elseif input.KeyCode == Enum.KeyCode.G then pearlCatch() end
end))

-- Panel drag
local dragging, dragStart, startPos = false, nil, nil
track(headerDrag.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = frame.Position
    end
end))
track(UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if CFG.panelLock then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end))
track(UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

-- ================= DESTROY / API =================
local function destroy()
    if destroyed then return end
    destroyed = true
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    pcall(function() RunService:UnbindFromRenderStep(CAMERA_BIND) end)
    pcall(function() RunService:UnbindFromRenderStep(ESP_BIND) end)
    pcall(function() espGui:Destroy() end)
    pcall(function() pearlGui:Destroy() end)
    pcall(function() gui:Destroy() end)
    if env.UNSTABLE_SMP_CFG == CFG then env.UNSTABLE_SMP_CFG = nil end
    if env.UNSTABLE_SMP and env.UNSTABLE_SMP.destroy == destroy then env.UNSTABLE_SMP = nil end
end

env.UNSTABLE_SMP = {
    cfg = CFG, pearlCatch = pearlCatch, windLaunch = windLaunch,
    autoMace = autoMace, autoFarm = autoFarm, refresh = refresh, destroy = destroy
}

updateStatus()
notify("Unstable SMP loaded", T.success, 2)