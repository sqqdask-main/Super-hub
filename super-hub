-- ================= GAME LOGIC (تمامًا كما في السكربت الأصلي) =================
local function entityId() local c = plr.Character; return c and c:GetAttribute("EntityId") or nil end
local function pearlModelPos(pid)
    local f = workspace:FindFirstChild("MCWorld"); f = f and f:FindFirstChild("Projectiles")
    local m = f and pid and f:FindFirstChild("Proj" .. tostring(pid))
    return m and m.PrimaryPart and m.PrimaryPart.Position or nil
end

Net.on("proj", function(data)
    if destroyed then return end
    if data.kind == "pearl" and tostring(data.owner) == tostring(entityId()) then
        pearlCapture = data.pid
        pearlTrack = { pid = data.pid, pos = data.pos, vel = data.vel, g = data.g or 0, drag = data.drag or 1 }
    end
end)
Net.on("projSync", function(data)
    if destroyed or not pearlTrack or data.pid ~= pearlTrack.pid then return end
    pearlTrack.pos = data.pos; pearlTrack.vel = data.vel
    pearlTrack.g = data.g or pearlTrack.g; pearlTrack.drag = data.drag or pearlTrack.drag
end)
Net.on("projEnd", function(data) if pearlTrack and data.pid == pearlTrack.pid then pearlTrack = nil end end)

local function track(c) connections[#connections+1] = c; return c end

local function snapshot(look)
    local s = Controller.state
    if not s or not s.pos then return nil end
    return {
        fall = s.fallDistance or 0, ground = s.onGround == true,
        sprint = s.sprinting == true, water = s.inWater == true,
        gliding = s.gliding == true, vel = s.vel or Vector3.new(),
        look = look, swap = false, pos = s.pos, predicted = true
    }
end

local function bestTarget(override)
    local range = override or CFG.range
    local eye = Controller.eye(); if not eye then return nil end
    local ok, targets = pcall(World.targets); if not ok or type(targets) ~= "table" then return nil end
    local best, bd = nil, nil
    for _, t in ipairs(targets) do
        local c = t.feet + Vector3.new(0, (t.height or 1.8) * 0.5, 0)
        local d = (c - eye).Magnitude
        if d <= range and (not bd or d < bd) then best, bd = t, d end
    end
    return best, eye
end

local function nearestTarget(maxR)
    local eye = Controller.eye(); if not eye then return nil end
    local ok, targets = pcall(World.targets); if not ok or type(targets) ~= "table" then return nil end
    local best, bd = nil, nil
    for _, t in ipairs(targets) do
        local d = (t.feet - eye).Magnitude
        if d <= maxR and (not bd or d < bd) then best, bd = t, d end
    end
    return best, bd
end

local function moveToward(targetPos)
    local s = Controller.state; if not s or not s.pos then return end
    local d = Vector3.new(targetPos.X - s.pos.X, 0, targetPos.Z - s.pos.Z)
    if d.Magnitude < 0.3 then return end
    local dir = d.Unit
    if type(Controller.setMoveDir) == "function" then pcall(Controller.setMoveDir, dir); return end
    if type(Controller.move) == "function" then pcall(Controller.move, dir, true); return end
    if Controller.moveX ~= nil and Controller.moveZ ~= nil then
        local c, si = math.cos(Controller.yaw or 0), math.sin(Controller.yaw or 0)
        Controller.moveX = dir.X * c - dir.Z * si
        Controller.moveZ = dir.X * si + dir.Z * c
        return
    end
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then pcall(hum.MoveTo, hum, targetPos); return end
    end
    pcall(Net.send, { a = "move", x = dir.X, z = dir.Z, sprint = true })
end

local function updateCameraTarget()
    if not CFG.camLock or Controller.locked then camTarget = nil; return end
    camTarget = bestTarget()
end

local function aimCamera(dt)
    if destroyed or not CFG.camLock or not camTarget then return end
    if Controller.locked or Controller.frozen then return end
    local eye = Controller.eye(); if not eye then return end
    local t = camTarget
    local d = t.feet + Vector3.new(0, (t.height or 1.8) * 0.6, 0) - eye
    if d.Magnitude < 0.0001 then return end
    local dYaw = math.atan2(-d.X, -d.Z)
    local dPitch = math.atan2(d.Y, math.sqrt(d.X*d.X + d.Z*d.Z))
    local smooth = math.clamp(CFG.camSmooth or 8, 1, 20)
    local alpha = 1 - math.exp(-(dt or (1/60)) * (21 - smooth) * 1.2)
    local diff = (dYaw - Controller.yaw + math.pi) % (2*math.pi) - math.pi
    Controller.yaw = (Controller.yaw + diff * alpha + math.pi) % (2*math.pi) - math.pi
    Controller.pitch = Controller.pitch + (dPitch - Controller.pitch) * alpha
    Controller.pitch = math.clamp(Controller.pitch, -math.pi/2, math.pi/2)
end

local function canCrit()
    if not CFG.critOnly then return true end
    local s = Controller.state; if not s then return false end
    if (s.fallDistance or 0) <= 0 then return false end
    if s.onGround == true or s.inWater == true or s.sprinting == true or s.gliding == true or s.flying == true then return false end
    return true
end

