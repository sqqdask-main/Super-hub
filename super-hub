local function ensureTotem()
    if not CFG.autoTotem or totemBusy or pearlBusy then return end
    local inv = Hands.inv; if not inv then return end
    local off = inv.offhand; local offId = type(off) == "table" and off.id or nil
    if offId == TOTEM_ID then return end
    local offEmpty = off == nil or offId == nil
    local hp = plr:GetAttribute("Health") or 20
    if not offEmpty and hp > CFG.totemHealth then return end
    if offEmpty and inv.cursor and inv.cursor.id == TOTEM_ID then
        Net.send({ a = "inv", op = "click", slot = 10, right = false, shift = false }); return
    end
    if inv.cursor then return end
    local slot = hotbarSlot(TOTEM_ID)
    if slot then
        if inv.selected ~= slot then pcall(Hands.select, slot); return end
        if Hands.stopUsing then pcall(Hands.stopUsing, false) end
        local cur = inv.hotbar[inv.selected]
        inv.hotbar[inv.selected] = inv.offhand
        inv.offhand = cur
        pcall(Net.send, { a = "swap" }); Hands.attackReset = Controller.tickCount
        return
    end
    local inv2 = inv.inventory; if not inv2 then return end
    local mx = 0; for k in pairs(inv2) do if type(k) == "number" and k > mx then mx = k end end
    for i = 1, mx do
        local it = inv2[i]
        if it and it.id == TOTEM_ID then
            totemBusy = true
            task.spawn(function()
                pcall(function()
                    Net.send({ a = "inv", op = "click", slot = i + 10, right = false, shift = false })
                    task.wait(0.08)
                    local cur = Hands.inv.cursor
                    if not cur or cur.id ~= TOTEM_ID then return end
                    Net.send({ a = "inv", op = "click", slot = 10, right = false, shift = false })
                    task.wait(0.08)
                    if Hands.inv.cursor then Net.send({ a = "inv", op = "click", slot = i + 10, right = false, shift = false }) end
                end)
                totemBusy = false
            end)
            return
        end
    end
end

pearlCatch = function()
