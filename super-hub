local function makeSlider(parent, key, labelText, min, max, step, format)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 44)
    row.BackgroundTransparency = 1
    row.Parent = parent
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextColor3 = T.text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row
    local val = Instance.new("TextLabel")
    val.Size = UDim2.fromOffset(60, 16)
    val.Position = UDim2.new(1, -60, 0, 0)
    val.BackgroundTransparency = 1
    val.Text = format:format(CFG[key])
    val.Font = Enum.Font.Code
    val.TextSize = 11
    val.TextColor3 = T.accentGlow
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = row
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.fromOffset(0, 26)
    track.BackgroundColor3 = T.bgInput
    track.BorderSizePixel = 0
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local ratio = (CFG[key] - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = T.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = UDim2.new(ratio, -7, 0.5, -7)
    knob.BackgroundColor3 = T.text
    knob.BorderSizePixel = 0
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, 0, 1, 0)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Parent = row
    local dragging = false
    local function setFromX(x)
        local absX, w = track.AbsolutePosition.X, track.AbsoluteSize.X
        local r = math.clamp((x - absX) / w, 0, 1)
        local raw = min + r * (max - min)
        local stepped = math.floor(raw / step + 0.5) * step
        CFG[key] = math.clamp(stepped, min, max)
        val.Text = format:format(CFG[key])
        local nr = (CFG[key] - min) / (max - min)
        fill.Size = UDim2.new(nr, 0, 1, 0)
        knob.Position = UDim2.new(nr, -7, 0.5, -7)
    end
    hit.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            dragging = true; setFromX(io.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(io)
        if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
            setFromX(io.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    valueLabels[key] = { lbl = val, format = format, fill = fill, knob = knob, min = min, max = max }
end

