local function notify(text, color, duration)
    color = color or T.accent
    duration = duration or 2
    local toast = Instance.new("TextLabel")
    toast.Size = UDim2.new(1, 0, 0, 32)
    toast.BackgroundColor3 = T.bgElevated
    toast.Text = "  ●  " .. text
    toast.Font = Enum.Font.GothamMedium
    toast.TextSize = 12
    toast.TextColor3 = T.text
    toast.TextXAlignment = Enum.TextXAlignment.Left
    toast.Position = UDim2.new(1, 20, 0, 0)
    toast.Parent = notifFrame
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = toast
    local s = Instance.new("UIStroke"); s.Color = color; s.Thickness = 1.5; s.Parent = toast
    TweenService:Create(toast, TweenInfo.new(0.25), { Position = UDim2.new(0, 0, 0, 0) }):Play()
    task.delay(duration, function()
        if toast.Parent then
            TweenService:Create(toast, TweenInfo.new(0.25), { Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1 }):Play()
            task.wait(0.3)
            if toast.Parent then toast:Destroy() end
        end
    end)
end

