autoMace = function()
    if not CFG.autoMace then return end
    if destroyed or pearlBusy or windBusy then return end
    if Controller.locked or workspace:GetAttribute("JugHold") == true then return end
    local c = plr.Character; if not c or c:GetAttribute("Alive") ~= true then return end
    local okM, mode = pcall(Hands.gamemode); if okM and mode == "spectator" then return end
    local s = Controller.state; if not s then return end
    local inv = Hands.inv; if not inv or not inv.selected then return end
    local onG = s.onGround == true; local fall = s.fallDistance or 0
    if onG and maceHasThrown and os.clock() - maceThrowTime > 1.5 then maceHasThrown = false end
    local t, eye = bestTarget(CFG.maceRange or CFG.range); if not t then return end
    if not onG then
        local ms = hotbarSlot(MACE_ID); if not ms then return end
        if inv.selected ~= ms then pcall(Hands.select, ms); return end
        if fall < 0.3 then return end
        local now = os.clock(); if now - lastMaceAttack < 0.3 then return end
        local aim = t.feet + Vector3.new(0, (t.height or 1.8)*0.6, 0) - eye
        if aim.Magnitude < 0.0001 then return end
        local st = snapshot(aim.Unit); if not st then return end
        pcall(Net.send, { a = "attack", target = t.id, st = st })
        Hands.attackReset = Controller.tickCount; Hands.swing = os.clock(); lastMaceAttack = now
        return
    end
    if maceHasThrown then return end
    local ws = hotbarSlot(WIND_ID); if not ws then status.Text = "Mace: need wind"; return end
    local okCd, cd = pcall(Hands.cooldownFraction, WIND_ID); if okCd and cd > 0 then return end
    if inv.selected ~= ws then pcall(Hands.select, ws); return end
    Hands.cooldowns = Hands.cooldowns or {}
    pcall(Net.send, { a = "use", hand = "main", look = Vector3.new(0,-1,0), item = WIND_ID, predictWind = false })
    Hands.cooldowns[WIND_ID] = { start = os.clock(), ticks = 10 }
    maceHasThrown = true; maceThrowTime = os.clock()
end

autoFarm = function()
    if not CFG.autoFarm then return end
    if destroyed or Controller.locked or workspace:GetAttribute("JugHold") == true then return end
    local c = plr.Character; if not c or c:GetAttribute("Alive") ~= true then return end
    local okM, mode = pcall(Hands.gamemode); if okM and mode == "spectator" then return end
    local s = Controller.state; if not s then return end
    local inv = Hands.inv; if not inv or not inv.selected then return end
    local now = os.clock()
    local t, dist = nearestTarget(CFG.farmRange or 30)
    if not t then farmState = "idle"; return end
    if farmState == "idle" then farmState = "walking"; farmStepStart = now end
    if farmState == "walking" then
        if dist and dist > 5 then moveToward(t.feet); return end
        local ps = hotbarSlot(PEARL_ID); if not ps then status.Text = "Farm: no pearl"; return end
        local okP, pcd = pcall(Hands.cooldownFraction, PEARL_ID); if okP and pcd > 0 then return end
        Hands.cooldowns = Hands.cooldowns or {}
        pcall(Hands.select, ps)
        pcall(Net.send, { a = "use", hand = "main", look = Vector3.new(0,1,0), item = PEARL_ID })
        Hands.cooldowns[PEARL_ID] = { start = now, ticks = 20 }
        farmState = "pearlThrown"; farmStepStart = now
        return
    end
    if farmState == "pearlThrown" then
        if now - farmStepStart >= 0.5 then
            local ws = hotbarSlot(WIND_ID); if not ws then farmState = "idle"; return end
            local okW, wcd = pcall(Hands.cooldownFraction, WIND_ID); if okW and wcd > 0 then return end
            Hands.cooldowns = Hands.cooldowns or {}
            pcall(Hands.select, ws)
            pcall(Net.send, { a = "use", hand = "main", look = Vector3.new(0,-1,0), item = WIND_ID, predictWind = false })
            Hands.cooldowns[WIND_ID] = { start = now, ticks = 10 }
            farmState = "attacking"; farmStepStart = now
        end
        return
    end
    if farmState == "attacking" then
        local ms = hotbarSlot(MACE_ID); if not ms then farmState = "idle"; return end
        if inv.selected ~= ms then pcall(Hands.select, ms); return end
        if now - lastFarmAttack >= 0.5 then
            local tg, eye = bestTarget(CFG.range)
            if tg and eye then
                local aim = tg.feet + Vector3.new(0, (tg.height or 1.8)*0.6, 0) - eye
                if aim.Magnitude > 0.0001 then
                    local st = snapshot(aim.Unit)
                    if st then
                        pcall(Net.send, { a = "attack", target = tg.id, st = st })
                        Hands.attackReset = Controller.tickCount; Hands.swing = now; lastFarmAttack = now
                    end
                end
            end
        end
        if s.onGround and now - farmStepStart > 1.2 then farmState = "walking"; farmStepStart = now end
    end
end

