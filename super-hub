    espElements[id] = { box=box, stroke=st, name=nm, healthBg=hb, healthFill=hf }
    return espElements[id]
end

local function updateEsp()
    if destroyed then return end
    if not CFG.esp then
        for _, e in pairs(espElements) do hideEsp(e) end
        return
    end
    local cam = workspace.CurrentCamera; if not cam then return end
    local ok, targets = pcall(World.targets)
    if not ok or type(targets) ~= "table" then for _,e in pairs(espElements) do hideEsp(e) end; return end
    local eye = Controller.eye(); local seen = {}
    for _, t in ipairs(targets) do
        local m = t.model
        if m and m.Parent and t.id ~= nil then
            local okB, bounds, size = pcall(function() return m:GetBoundingBox() end)
            if okB and bounds and size then
                local top = bounds.Position + Vector3.new(0, size.Y*0.5, 0)
                local bot = bounds.Position - Vector3.new(0, size.Y*0.5, 0)
                local ts, bs = cam:WorldToViewportPoint(top), cam:WorldToViewportPoint(bot)
                if ts.Z > 0 and bs.Z > 0 then
                    local cx = (ts.X + bs.X)*0.5
                    local tY, bY = math.min(ts.Y, bs.Y), math.max(ts.Y, bs.Y)
                    local h = bY - tY
                    if h >= 8 and cx > -100 and cx < cam.ViewportSize.X + 100 and bY > -100 and tY < cam.ViewportSize.Y + 100 then
                        local w = math.clamp(h * ((t.width or 0.6)/(t.height or 1.8)), 10, 220)
                        local e = espElements[t.id] or makeEspElement(t.id)
                        local dummy = m:GetAttribute("Dummy") == true
                        local hp = tonumber(m:GetAttribute("Health")) or 0
                        local mhp = tonumber(m:GetAttribute("MaxHealth")) or 20
                        local disp = m:GetAttribute("DisplayName") or m.Name
                        local dist = eye and math.floor((t.feet - eye).Magnitude + 0.5) or 0
                        local hf = mhp > 0 and math.clamp(hp/mhp,0,1) or 0
                        e.stroke.Color = dummy and Color3.fromRGB(255,180,80) or Color3.fromRGB(255,80,80)
                        e.box.Position = UDim2.fromOffset(math.floor(cx - w*0.5), math.floor(tY))
                        e.box.Size = UDim2.fromOffset(math.floor(w), math.floor(h))
                        e.box.Visible = true
                        e.name.Text = string.format("%s  %d/%d  %dm", tostring(disp), hp, mhp, dist)
                        e.name.Position = UDim2.fromOffset(math.floor(cx-110), math.floor(tY-16))
                        e.name.Size = UDim2.fromOffset(220, 14); e.name.Visible = true
                        e.healthBg.Position = UDim2.fromOffset(math.floor(cx - w*0.5 - 7), math.floor(tY))
                        e.healthBg.Size = UDim2.fromOffset(3, math.floor(h)); e.healthBg.Visible = true
                        e.healthFill.Size = UDim2.new(1,0,hf,0)
                        e.healthFill.BackgroundColor3 = hf > 0.6 and Color3.fromRGB(80,220,100) or (hf > 0.3 and Color3.fromRGB(235,200,70) or Color3.fromRGB(235,70,70))
                        e.healthFill.Visible = true; seen[t.id] = true
                    end
                end
            end
        end
    end
    for id, e in pairs(espElements) do if not seen[id] then hideEsp(e) end end
end

