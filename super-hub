-- ============ BETA SCRIPT ============
local betaGui, betaConnections = nil, {}
local betaActive = false
local lastAttack = 0

betaBtn.MouseButton1Click:Connect(function()
    -- احذف واجهة الـ Hub
    hubGui:Destroy()

    -- جيب الموديولات
    local MC = plr.PlayerScripts:WaitForChild("MC", 10)
    if not MC then return end
    local okN, Net = pcall(require, MC:WaitForChild("Net")); if not okN then return end
    local okH, Hands = pcall(require, MC:WaitForChild("Hands")); if not okH then return end
    local okC, Controller = pcall(require, MC:WaitForChild("Controller")); if not okC then return end
    local okW, World = pcall(require, MC:WaitForChild("World")); if not okW then return end

    -- واجهة الزر العائم
    betaGui = Instance.new("ScreenGui")
    betaGui.Name = "UNSTABLE_SMP_BETA"
    betaGui.ResetOnSpawn = false
    betaGui.IgnoreGuiInset = true
    betaGui.DisplayOrder = 1000000
    betaGui.Parent = playerGui

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(70, 70)
    btn.Position = UDim2.new(1, -90, 0.5, -35)
    btn.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
    btn.Text = "KA\nOFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.AutoButtonColor = false
    btn.Active = true
    btn.Parent = betaGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
    local bstroke = Instance.new("UIStroke")
    bstroke.Color = Color3.fromRGB(255, 140, 140)
    bstroke.Thickness = 2
    bstroke.Parent = btn

    -- دعم السحب + التمييز بين الضغط والسحب
    local bDragging, bMoved, bDragStart, bStartPos = false, false, nil, nil
    table.insert(betaConnections, btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            bDragging = true
            bMoved = false
            bDragStart = input.Position
            bStartPos = btn.Position
        end
    end))
    table.insert(betaConnections, UIS.InputChanged:Connect(function(input)
        if not bDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - bDragStart
            if d.Magnitude > 6 then bMoved = true end
            btn.Position = UDim2.new(bStartPos.X.Scale, bStartPos.X.Offset + d.X, bStartPos.Y.Scale, bStartPos.Y.Offset + d.Y)
        end
    end))
    table.insert(betaConnections, UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if bDragging and not bMoved then
                -- toggle
                betaActive = not betaActive
                if betaActive then
                    btn.Text = "KA\nON"
                    btn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
                    bstroke.Color = Color3.fromRGB(140, 255, 160)
                else
                    btn.Text = "KA\nOFF"
                    btn.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
                    bstroke.Color = Color3.fromRGB(255, 140, 140)
                end
            end
            bDragging = false
        end
    end))

    -- Crit only دائماً مفعّل
    local function canCrit()
        local s = Controller.state
        if not s then return false end
        if (s.fallDistance or 0) <= 0 then return false end
        if s.onGround or s.inWater or s.sprinting or s.gliding or s.flying then return false end
        return true
    end

    local function snapshot(look)
        local s = Controller.state
        if not s or not s.pos then return nil end
        return {
            fall = s.fallDistance or 0, ground = s.onGround == true,
            sprint = s.sprinting == true, water = s.inWater == true,
            gliding = s.gliding == true, vel = s.vel or Vector3.new(),
            look = look, swap = false, pos = s.pos, predicted = true
        }
    end

    -- Killaura كل ثانية
    table.insert(betaConnections, RunService.Heartbeat:Connect(function()
        if not betaActive then return end
        if Controller.locked or workspace:GetAttribute("JugHold") == true then return end

        local c = plr.Character
        if not c or c:GetAttribute("Alive") ~= true then return end
        local okM, mode = pcall(Hands.gamemode); if okM and mode == "spectator" then return end
        local okS, str = pcall(Hands.strength); if not okS or str < 0.95 then return end

        -- Crit only دائماً
        if not canCrit() then return end

        -- كل ثانية
        local now = os.clock()
        if now - lastAttack < 1 then return end

        local eye = Controller.eye()
        if not eye then return end
        local ok, targets = pcall(World.targets)
        if not ok or type(targets) ~= "table" then return end

        local best, bd
        for _, t in ipairs(targets) do
            local ctr = t.feet + Vector3.new(0, (t.height or 1.8) * 0.5, 0)
            local d = (ctr - eye).Magnitude
            if d <= 4 and (not bd or d < bd) then best, bd = t, d end
        end
        if not best then return end

        local aim = best.feet + Vector3.new(0, (best.height or 1.8) * 0.6, 0) - eye
        if aim.Magnitude < 0.0001 then return end
        local st = snapshot(aim.Unit)
        if not st then return end

        if pcall(Net.send, { a = "attack", target = best.id, st = st }) then
            Hands.attackReset = Controller.tickCount
            Hands.swing = now
            lastAttack = now
        end
    end))
end)

-- ============ API ============
env.UNSTABLE_SMP_HUB = {
    destroy = function()
        for _, c in ipairs(betaConnections) do pcall(function() c:Disconnect() end) end
        betaConnections = {}
        if hubGui then pcall(function() hubGui:Destroy() end) end
        if betaGui then pcall(function() betaGui:Destroy() end) end
    end
}