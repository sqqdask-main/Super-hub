    nm.TextXAlignment = Enum.TextXAlignment.Center; nm.TextYAlignment = Enum.TextYAlignment.Bottom
    nm.Visible = false; nm.Parent = espGui
    local hb = Instance.new("Frame")
    hb.BackgroundColor3 = Color3.fromRGB(12,12,12); hb.BorderSizePixel = 0; hb.Visible = false; hb.Parent = espGui
