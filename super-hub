    local okP, pcd = pcall(Hands.cooldownFraction, PEARL_ID)
    local okW, wcd = pcall(Hands.cooldownFraction, WIND_ID)
    if (okP and pcd > 0) or (okW and wcd > 0) then status.Text = "Pearl: cooldown"; return false end
    local inv = Hands.inv; if not inv or not inv.selected then return false end
    local orig = inv.selected; local look = Vector3.new(0, 1, 0)
    pearlBusy = true; pearlTrack = nil; pearlCapture = nil
