local function setupFloatDrag(button, onClick, flashColor, baseColor)
    local dragging, moved, dragInput, dragStart, startPos = false, false, nil, nil, nil
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; moved = false; dragInput = input
            dragStart = input.Position
            startPos = UDim2.fromOffset(button.AbsolutePosition.X, button.AbsolutePosition.Y)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging or input ~= dragInput then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            if d.Magnitude > 6 then moved = true end
            if CFG.pearlLock then return end
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1280,720)
            local w, h = button.AbsoluteSize.X, button.AbsoluteSize.Y
            button.Position = UDim2.fromOffset(
                math.clamp(startPos.X.Offset + d.X, 0, math.max(0, vp.X - w)),
                math.clamp(startPos.Y.Offset + d.Y, 0, math.max(0, vp.Y - h))
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and input == dragInput and not moved then
                if onClick() and flashColor then
                    button.BackgroundColor3 = flashColor
                    task.delay(0.15, function() if button.Parent then button.BackgroundColor3 = baseColor end end)
                end
            end
            dragging = false; dragInput = nil
        end
    end)
end

